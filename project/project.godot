; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project"
run/main_scene="res://scenes/test_arena.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoloads/EventBus.gd"
SimulationClock="*res://src/autoloads/SimulationClock.gd"
WorldCalendar="*res://src/autoloads/WorldCalendar.gd"
FloorLayerManager="*res://src/autoloads/FloorLayerManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

