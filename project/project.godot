[layer_names]

2d_physics/layer_1="Slot0_HighWalls"
2d_physics/layer_2="Slot0_LowObstacles"
2d_physics/layer_3="Slot0_Actors"
2d_physics/layer_4="Slot1_HighWalls"
2d_physics/layer_5="Slot1_LowObstacles"
2d_physics/layer_6="Slot1_Actors"
2d_physics/layer_7="Slot2_HighWalls"
2d_physics/layer_8="Slot2_LowObstacles"
2d_physics/layer_9="Slot2_Actors"
2d_physics/layer_10="Slot3_HighWalls"
2d_physics/layer_11="Slot3_LowObstacles"
2d_physics/layer_12="Slot3_Actors"
2d_physics/layer_13="HitboxZones"
2d_physics/layer_14="Projectiles"
2d_physics/layer_15="Interactables"
2d_physics/layer_16="MindDomains"
2d_physics/layer_17="FloorSupport"
2d_physics/layer_18="Triggers_Stealth"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
